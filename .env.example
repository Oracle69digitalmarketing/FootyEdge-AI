# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# The Odds API
ODDS_API_KEY=your_odds_api_key

# API-Football (Objective 10.2C.2, players-only squad sync). Server-side
# only: never commit a real value, never expose to the frontend. The
# nightly sync reads this strictly from the server environment.
API_FOOTBALL_KEY=

# Security
CRON_SECRET_TOKEN=your_secure_cron_passphrase

# Billing (Paystack). Placeholders only — never commit real values.
# PAYSTACK_MODE must be test|live; the secret prefix must match the mode.
# Live values only under a launch objective; Objective 8 is test mode.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=your_paystack_test_secret_key
PAYSTACK_GROWTH_PLAN_CODE=your_paystack_growth_plan_code
PAYSTACK_BUSINESS_PLAN_CODE=your_paystack_business_plan_code

# Telegram transport adapter (Objective 9.1). Placeholders only — never commit
# real values. The bot token stays server-side; the webhook secret is compared
# constant-time on every delivery. Inactive until separately authorized.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp transport adapter + notifications. Placeholders only — never commit
# real values. All four stay server-side; the app secret signs webhook
# deliveries (constant-time HMAC) and the verify token answers Meta's
# challenge. Templates must be approved in the WhatsApp Manager before
# notification delivery; the names below are defaults, not registered
# templates. Inactive until separately authorized: no webhook is
# registered and no notification job is scheduled from this repository.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_MATCH_UPDATE=footyedge_match_update
WHATSAPP_TEMPLATE_PREDICTION_ALERT=footyedge_prediction_alert

# API URL
API_URL=http://localhost:8000
